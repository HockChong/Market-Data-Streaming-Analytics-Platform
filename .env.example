# Kafka Configuration (Confluent Cloud)
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-west-2.aws.confluent.cloud:9092
KAFKA_TOPIC_STREAMING=polygon-streaming-ohlcv
KAFKA_GROUP_ID=market-data-consumer-group
# API Key (Confluent Cloud)
KAFKA_SASL_USERNAME=your-kafka-api-key
# API Secret (Confluent Cloud)
KAFKA_SASL_PASSWORD=your-kafka-api-secret

# Schema Registry (Confluent Cloud)
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.us-west-2.aws.confluent.cloud
SCHEMA_REGISTRY_API_KEY=your-schema-registry-api-key
SCHEMA_REGISTRY_API_SECRET=your-schema-registry-api-secret

# Polygon.io API
POLYGON_API_KEY=your-polygon-api-key

# Polygon.io Flat Files (S3 Endpoint)
POLYGON_FLATFILES_ENDPOINT=https://files.massive.com
POLYGON_FLATFILES_BUCKET=flatfiles
POLYGON_FLATFILES_PREFIX=us_stocks_sip/minute_aggs_v1
POLYGON_AWS_ACCESS_KEY_ID=your-polygon-aws-access-key
POLYGON_AWS_SECRET_ACCESS_KEY=your-polygon-aws-secret-key

# Databricks (for add_secrets_rest_api.py)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


